# Copier depuis la racine du monorepo ou définir ici (prioritaire)
DATABASE_URL=postgresql://postgres:qdia1234@localhost:5434/qdia_export

# Optionnel : CSV/Excel si pas de Postgres
# CSV_FALLBACK=./products.csv

# Sortie images + reprise
OUTPUT_DIR=./output/images
LOG_DIR=./logs
STATE_FILE=./output/progress.json
REPORT_FILE=./output/report.json
PUBLIC_IMAGE_PREFIX=/uploads/catalog
WATERMARK_PATH=./assets/watermark.png

# Images
TARGET_SIZE=1024
MIN_RESOLUTION=800
JPEG_QUALITY=88
WATERMARK_OPACITY=0.25

# Scraping
SEARCH_ENGINE=google
HEADLESS=true
DELAY_MIN=1.5
DELAY_MAX=3.5
MAX_WORKERS=2
BATCH_LIMIT=0
ONLY_WITHOUT_PHOTO=true

# Fond : auto | rembg | removebg | none
BG_PROVIDER=auto
REMOVEBG_API_KEY=

# Bonus descriptions
OPENAI_API_KEY=
GENERATE_DESCRIPTIONS=false
TRANSLATE_DESCRIPTIONS=false
