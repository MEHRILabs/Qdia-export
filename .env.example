# ─── APIs Intelligence Artificielle ───
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_CHAT_PROVIDER=openai
AI_VISION_PROVIDER=openai
AI_BENCHMARK_PROVIDER=openai
AI_IMAGE_PROVIDER=openai
AI_FALLBACK_ENABLED=true
REMOVEBG_API_KEY=

# ─── Auth JWT ───
# Production : min. 32 caractères — openssl rand -base64 48
JWT_SECRET=changez-ce-secret-en-production
JWT_EXPIRES_IN=7d

# ─── Sécurité HTTP ───
# Origines CORS autorisées (virgules) — ex: https://qdia-export.vercel.app
CORS_ORIGINS=
FRONTEND_URL=http://localhost:25180
# Neon/Vercel : mettre false si erreur SSL PostgreSQL
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ─── Taux de change DZD ───
DZD_USD_RATE=0.0074
DZD_EUR_RATE=0.0068
DZD_AED_RATE=0.0272

# ─── Mail (optionnel) ───
MAIL_HOST=smtp.votre-hebergeur.com
MAIL_PORT=587
MAIL_USERNAME=support@qdiadz.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@qdiadz.com
MAIL_FROM_NAME=QDIA Export

# ─── Pusher / WebSocket (optionnel) ───
PUSHER_APP_ID=qdia_app
PUSHER_APP_KEY=qdia_key
PUSHER_APP_SECRET=qdia_secret
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http

# ─── AWS S3 (optionnel) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ─── Twilio SMS OTP ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Firebase Cloud Messaging (legacy server key) ───
FIREBASE_LEGACY_SERVER_KEY=
FCM_SERVER_KEY=

# ─── Stripe abonnements ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GOLD=
SITE_URL=http://localhost:25180

# ─── Commission plateforme (défaut 3 %) ───
COMMISSION_RATE=0.03

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

