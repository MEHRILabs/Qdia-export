# ─── URLs production (référence) ───
# SITE_URL=https://qdiadz.com
# EXPORT_URL=https://export.qdiadz.com
# SELLER_URL=https://seller.qdiadz.com
# STUDIO_URL=https://studio.qdiadz.com
# ADMIN_URL=https://admin.qdiadz.com

# ─── PostgreSQL (QDIA Export — Node/Drizzle) ───
# Créer la base : psql -U postgres -c "CREATE DATABASE qdia_export;"
DATABASE_URL=postgresql://postgres:qdia1234@localhost:5434/qdia_export

# ─── Ancien MySQL Laravel (WAMP — référence, schéma différent) ───
